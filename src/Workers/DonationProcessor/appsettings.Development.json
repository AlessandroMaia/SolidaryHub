{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "RabbitMQ": "amqp://solidarity_user:Solidarity123@localhost:5672",
    "Loki": "http://loki:3100"
  },
  "Prometheus": {
    "ScrapeEndpointPath": "/metrics",
    "UriPrefixes": [
      "http://localhost:9464/"
    ]
  },
  "DonationOptions": {
    "Succeded": "true"
  }
}
