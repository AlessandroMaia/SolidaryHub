{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "CampaignDb": "Host=localhost;Port=5432;Database=campaign_db;Username=campaign_user;Password=change-me-campaign-db-password",
    "RabbitMQ": "amqp://solidarity_user:change-me-rabbitmq-password@localhost:5672",
    "Loki": "http://loki:3100"
  },
  "Prometheus": {
    "ScrapeEndpointPath": "/metrics"
  },
  "JwtSettings": {
    "Secret": "change-me-local-dev-jwt-secret-with-at-least-32-chars",
    "Issuer": "SH.IdentityService",
    "Audience": "SH.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  }
}
