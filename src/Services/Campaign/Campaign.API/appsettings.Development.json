{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "CampaignDb": "Host=localhost;Port=5432;Database=campaign_db;Username=campaign_user;Password=Campaign@123",
    "RabbitMQ": "amqp://solidarity_user:Solidarity123@localhost:5672",
    "Loki": "http://loki:3100"
  },
  "Prometheus": {
    "ScrapeEndpointPath": "/metrics"
  },
  "JwtSettings": {
    "Secret": "your-super-secret-key-min-32-chars-long-for-development-only",
    "Issuer": "SH.IdentityService",
    "Audience": "SH.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  }
}
