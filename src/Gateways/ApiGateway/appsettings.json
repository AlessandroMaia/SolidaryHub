{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Loki": "http://loki:3100"
  },
  "Prometheus": {
    "ScrapeEndpointPath": "/metrics"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:5000",
      "https://localhost:5000"
    ]
  },
  "GatewaySecurity": {
    "EnableHttpsRedirection": false,
    "EnableHsts": false
  },
  "ForwardedHeaders": {
    "TrustAllProxies": true
  },
  "JwtSettings": {
    "Secret": "your-super-secret-key-min-32-chars-long-for-development-only",
    "Issuer": "SH.IdentityService",
    "Audience": "SH.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "ReverseProxy": {
    "Routes": {
      "IdentityOpenApi": {
        "ClusterId": "IdentityCluster",
        "Order": -100,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/docs/openapi/identity.json",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          },
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "CampaignOpenApi": {
        "ClusterId": "CampaignCluster",
        "Order": -100,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/docs/openapi/campaign.json",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          },
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "IdentityRegister": {
        "ClusterId": "IdentityCluster",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/api/auth/register",
          "Methods": [ "POST" ]
        }
      },
      "IdentitySignIn": {
        "ClusterId": "IdentityCluster",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/api/auth/sign-in",
          "Methods": [ "POST" ]
        }
      },
      "IdentityRefresh": {
        "ClusterId": "IdentityCluster",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/api/auth/refresh",
          "Methods": [ "POST" ]
        }
      },
      "IdentityAuthenticated": {
        "ClusterId": "IdentityCluster",
        "Order": 1,
        "AuthorizationPolicy": "RequireManagerOrDonorUser",
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/api/auth/change-password",
          "Methods": [ "PUT" ]
        }
      },
      "IdentityValidate": {
        "ClusterId": "IdentityCluster",
        "Order": 1,
        "AuthorizationPolicy": "RequireManagerOrDonorUser",
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/api/auth/validate",
          "Methods": [ "GET" ]
        }
      },
      "IdentityCurrentUser": {
        "ClusterId": "IdentityCluster",
        "Order": 1,
        "AuthorizationPolicy": "RequireManagerOrDonorUser",
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/api/users/me",
          "Methods": [ "GET" ]
        }
      },
      "IdentityUserById": {
        "ClusterId": "IdentityCluster",
        "Order": 1,
        "AuthorizationPolicy": "RequireManagerOrDonorUser",
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/api/users/{id:int}",
          "Methods": [ "GET" ]
        }
      },
      "CampaignPublicPanel": {
        "ClusterId": "CampaignCluster",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/api/campaigns/public-panel",
          "Methods": [ "GET" ]
        }
      },
      "CampaignActive": {
        "ClusterId": "CampaignCluster",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/api/campaigns/active",
          "Methods": [ "GET" ]
        }
      },
      "CampaignManagement": {
        "ClusterId": "CampaignCluster",
        "Order": 1,
        "AuthorizationPolicy": "RequireManagerUser",
        "RateLimiterPolicy": "management",
        "Match": {
          "Path": "/api/campaigns",
          "Methods": [ "GET", "POST" ]
        }
      },
      "CampaignGetById": {
        "ClusterId": "CampaignCluster",
        "Order": 1,
        "AuthorizationPolicy": "RequireManagerUser",
        "RateLimiterPolicy": "management",
        "Match": {
          "Path": "/api/campaigns/{id:int}",
          "Methods": [ "GET" ]
        }
      },
      "CampaignUpdate": {
        "ClusterId": "CampaignCluster",
        "Order": 1,
        "AuthorizationPolicy": "RequireManagerUser",
        "RateLimiterPolicy": "management",
        "Match": {
          "Path": "/api/campaigns/{id:int}",
          "Methods": [ "PUT" ]
        }
      },
      "CampaignComplete": {
        "ClusterId": "CampaignCluster",
        "Order": 1,
        "AuthorizationPolicy": "RequireManagerUser",
        "RateLimiterPolicy": "management",
        "Match": {
          "Path": "/api/campaigns/{id:int}/complete",
          "Methods": [ "PUT" ]
        }
      },
      "CampaignCancel": {
        "ClusterId": "CampaignCluster",
        "Order": 1,
        "AuthorizationPolicy": "RequireManagerUser",
        "RateLimiterPolicy": "management",
        "Match": {
          "Path": "/api/campaigns/{id:int}/cancel",
          "Methods": [ "PUT" ]
        }
      },
      "DonationIntentReject": {
        "ClusterId": "CampaignCluster",
        "Order": 0,
        "AuthorizationPolicy": "RequireManagerUser",
        "RateLimiterPolicy": "management",
        "Match": {
          "Path": "/api/donation-intents/{id:int}/reject",
          "Methods": [ "PUT" ]
        }
      },
      "DonationIntentByCampaign": {
        "ClusterId": "CampaignCluster",
        "Order": 0,
        "AuthorizationPolicy": "RequireManagerUser",
        "RateLimiterPolicy": "management",
        "Match": {
          "Path": "/api/donation-intents/campaigns/{campaignId:int}",
          "Methods": [ "GET" ]
        }
      },
      "DonationIntentPendings": {
        "ClusterId": "CampaignCluster",
        "Order": 0,
        "AuthorizationPolicy": "RequireManagerUser",
        "RateLimiterPolicy": "management",
        "Match": {
          "Path": "/api/donation-intents/pendings",
          "Methods": [ "GET" ]
        }
      },
      "DonationIntentCreate": {
        "ClusterId": "CampaignCluster",
        "Order": 1,
        "AuthorizationPolicy": "RequireDonorUser",
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/api/donation-intents/{campaignId:int}",
          "Methods": [ "POST" ]
        }
      },
      "DonationIntentGetById": {
        "ClusterId": "CampaignCluster",
        "Order": 1,
        "AuthorizationPolicy": "RequireManagerOrDonorUser",
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/api/donation-intents/{id:int}",
          "Methods": [ "GET" ]
        }
      },
      "DonationIntentGetByDonor": {
        "ClusterId": "CampaignCluster",
        "Order": 1,
        "AuthorizationPolicy": "RequireManagerOrDonorUser",
        "RateLimiterPolicy": "authenticated",
        "Match": {
          "Path": "/api/donation-intents/donors/{donorId:int}",
          "Methods": [ "GET" ]
        }
      }
    },
    "Clusters": {
      "IdentityCluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "IdentityApi": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "CampaignCluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:15",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "CampaignApi": {
            "Address": "http://localhost:5002/"
          }
        }
      }
    }
  }
}
